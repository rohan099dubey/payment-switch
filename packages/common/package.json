{
  "name": "@switch/common",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-cutting code shared by every service: config, logging, db, migrations, gRPC helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./tracing": "./dist/tracing.js"
  },
  "typesVersions": {
    "*": {
      "tracing": [
        "dist/tracing.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation-grpc": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.5"
  }
}
