# Normalize to LF in the repo; check out native on Windows for ordinary text.
* text=auto

# These are consumed inside Linux containers. CRLF breaks shell scripts and
# anything run by a container entrypoint, so force LF on checkout too.
*.sh       text eol=lf
*.sql      text eol=lf
*.lua      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.proto    text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Keep diffs readable
*.md       text
*.mmd      text
*.ts       text
*.js       text
*.json     text

# Generated — do not show in diffs
package-lock.json -diff linguist-generated
