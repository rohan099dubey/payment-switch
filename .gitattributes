# Normalize to LF in the repo; check out native on Windows for ordinary text.
* text=auto

# These are consumed inside Linux containers. CRLF breaks shell scripts and
# anything run by a container entrypoint, so force LF on checkout too.
*.sh       text eol=lf
*.sql      text eol=lf
*.lua      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.proto    text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Source and config: built inside Linux containers too, and Prettier enforces
# `endOfLine: lf`, so a CRLF checkout would fail `npm run lint` on a fresh Windows clone.
*.ts       text eol=lf
*.mts      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.json     text eol=lf
.prettierrc.json text eol=lf
.prettierignore  text eol=lf
.dockerignore    text eol=lf

# Prose: Prettier ignores these, so native line endings are fine
*.md       text
*.mmd      text

# Generated — do not show in diffs
package-lock.json -diff linguist-generated

# Rendered diagrams (docs/diagrams, ADR-023)
*.png      binary
