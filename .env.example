# Every environment variable from ARCHITECTURE.md section 15, with its default.
# This is a reference, grouped by service: several names (HTTP_PORT, GRPC_PORT,
# DATABASE_URL) are per-service, so each service's block shows its own value.
# docker-compose.yml sets the real values per container.

# ---------------------------------------------------------------- all services
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- gateway
HTTP_PORT=8080
# Required, at least 32 characters. No default.
JWT_SECRET=
JWT_TTL_SECONDS=900
# Required. JSON array of {client_id, client_secret}. No default.
# Example: [{"client_id":"demo","client_secret":"change-me-to-something-long"}]
API_CLIENTS=
REDIS_URL=redis://redis:6379
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
ORCHESTRATOR_ADDR=orchestrator:50051
ORCHESTRATOR_TIMEOUT_MS=10000
MAX_TRANSFER_AMOUNT=10000000

# ---------------------------------------------------------------- orchestrator
GRPC_PORT=50051
HTTP_PORT=9101
DATABASE_URL=postgres://orch:orch@postgres-orchestrator:5432/orchestrator_db
BANK_ENDPOINTS=bank_a=bank-a:50061,bank_b=bank-b:50062
LEDGER_ADDR=ledger:50052
MAX_TRANSFER_AMOUNT=10000000
BANK_CALL_TIMEOUT_MS=2000
LEDGER_CALL_TIMEOUT_MS=2000
INLINE_BANK_RETRIES=2
INLINE_LEDGER_RETRIES=2
SAGA_INLINE_BUDGET_MS=8000
# The Gateway's deadline; the Orchestrator reads it only to enforce
# SAGA_INLINE_BUDGET_MS < ORCHESTRATOR_TIMEOUT_MS at startup (section 14).
ORCHESTRATOR_TIMEOUT_MS=10000
REPLAY_WAIT_MS=2000
LEASE_MS=15000
RECOVERY_POLL_MS=1000
RECOVERY_BATCH=20
RECOVERY_CONCURRENCY=5
RESOLVE_AFTER_ATTEMPTS=3
MAX_RECOVERY_ATTEMPTS=20
# Defaults to the container hostname when unset.
INSTANCE_ID=

# ---------------------------------------------------------------- ledger
GRPC_PORT=50052
HTTP_PORT=9102
DATABASE_URL=postgres://ledger:ledger@postgres-ledger:5432/ledger_db

# ---------------------------------------------------------------- mock bank: bank-a
BANK_ID=bank_a
GRPC_PORT=50061
HTTP_PORT=9111
DATABASE_URL=postgres://banks:banks@postgres-banks:5432/bank_a

# ---------------------------------------------------------------- mock bank: bank-b
BANK_ID=bank_b
GRPC_PORT=50062
HTTP_PORT=9112
DATABASE_URL=postgres://banks:banks@postgres-banks:5432/bank_b

# ---------------------------------------------------------------- mock bank: both instances
CHAOS_SEED=42
CHAOS_DOWN=false
CHAOS_LATENCY_MIN_MS=0
CHAOS_LATENCY_MAX_MS=0
CHAOS_REJECT_RATE=0
CHAOS_LATE_APPLY_RATE=0
CHAOS_LOST_RESPONSE_RATE=0
CHAOS_SLOW_MS=3000
