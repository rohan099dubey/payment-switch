{
  "name": "payment-switch",
  "version": "0.0.0",
  "private": true,
  "description": "Mini UPI-style payment switch with a double-entry ledger",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "proto:gen": "buf generate",
    "proto:lint": "buf lint",
    "build": "npm run proto:gen && tsc -b",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:chaos": "vitest run --project chaos --silent=false",
    "test:k8s": "vitest run --project k8s --silent=false",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v",
    "k8s:up": "tsx scripts/k8s.ts up",
    "k8s:down": "tsx scripts/k8s.ts down",
    "seed": "tsx scripts/seed.ts",
    "invariants": "tsx scripts/checkInvariants.ts",
    "bench:balance": "tsx scripts/benchBalance.ts",
    "load": "k6 run load/transfer.k6.js"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@eslint/js": "10.0.1",
    "@grpc/grpc-js": "1.14.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "ioredis": "6.0.0",
    "kafkajs": "2.2.4",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "ts-proto": "2.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
